# คัดลอกจาก Supabase → Project Settings → API (ใส่ใน Vercel → Settings → Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ห้ามใส่ service_role key ในแอปหน้าเว็บ
# ไม่บังคับ: แผนที่ทรัพย์สินแบบภาพดาวเทียมคมชัด + ชื่อสถานที่ (Esri) · ArcGIS Location Platform → API key ที่ให้สิทธิ์เฉพาะ Basemaps
# และจำกัด Referrer เป็นโดเมนของแอป · ไม่ใส่ = ใช้ภาพ Sentinel-2 (~10 ม.) + ชื่อจาก CARTO แทน
NEXT_PUBLIC_ARCGIS_API_KEY=
